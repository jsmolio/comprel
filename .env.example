# compREL environment variables. Copy to .env and fill in.

# --- Database ---
# Local dev currently uses SQLite:
#   DATABASE_URL="file:./dev.db"
# Production (Supabase Postgres): use the POOLED connection for the app and the
# DIRECT connection for migrations.
#   App / pooled (Transaction pooler, port 6543):
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
#   Direct (port 5432, for prisma migrate):
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# --- Ingest auth (protects /api/ingest; Vercel Cron sends CRON_SECRET) ---
CRON_SECRET=""
# INGEST_TOKEN=""   # alternative name, also accepted

# --- Recommended ---
# Raises GitHub API rate limit for cache discovery (60/hr -> 5000/hr).
# In GitHub Actions this is provided automatically as github.token.
GITHUB_TOKEN=""

# --- Optional features ---
YOUTUBE_API_KEY=""   # on-demand gameplay video lookup
